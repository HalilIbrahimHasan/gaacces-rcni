# =============================================================================
# RCNI Phase 1 (Monthly Discrepancy outbound)
# =============================================================================
# Processing/archive year is the SFTP directory year — NOT the plan year
# encoded in the filename (MONTHLYDISCREPANCY_{plan_year}_{timestamp}).
#
# RCNI-specific path (replaces 834 SFTP_REMOTE_PATH for this runner only):
RCNI_BASE_PATH=/archive/out/good/PAS
#
# Scope uses the same 834 filters (empty = ALL). Do not use RCNI_ISSUER/YEAR/MONTH.
#   ISSUER_FILTER=15105
#   YEAR_FILTER=2026
#   MONTH_FILTER=07
#
# SFTP credentials: put them in THIS project's .env (same names as 834).
#   SFTP_HOST, SFTP_PORT, SFTP_USERNAME (or SFTP_USER), SFTP_PASSWORD
#
# Commands:
#   python run_rcni.py --discover-only --issuer 15105 --year 2026 --month 07
#   python run_rcni.py --validate --issuer 15105 --year 2026 --month 07
# RCNI never writes Azure SQL in Phase 1.

# Processing mode: local | ftp | sftp
PROCESSING_MODE=sftp

# Clean all outputs before each run (data, reports, extracted, assets)
CLEAN_ON_START=true

# Paths (relative to project root unless absolute)
SOURCE_DATA_PATH=source_data
EXTRACTED_PATH=extracted
DATABASE_PATH=data/issuer_834.db
REPORTS_PATH=reports
ASSETS_PATH=assets
LOGS_PATH=logs

# Optional filters — comma-separated, independent (empty = ALL)
# Examples:
#   YEAR_FILTER=2025
#   MONTH_FILTER=03,04,05,06
#   ISSUER_FILTER=13535,15105
ISSUER_FILTER=
YEAR_FILTER=2025
MONTH_FILTER=05

# Reference row counts for validation (issuer=expected_count, comma-separated)
# Example: Sigma=16464,86637=22
REFERENCE_ROW_COUNTS=

# User fee rate (3.25%)
USER_FEE_RATE=0.0325

# Cancellation window in days
CANCELLATION_WINDOW_DAYS=90

# --- FTP (dummy — not used in local mode) ---
FTP_HOST=ftp.example.com
FTP_PORT=21
FTP_USERNAME=dummy_user
FTP_PASSWORD=dummy_password
FTP_REMOTE_PATH=/incoming/834

# --- SFTP (set PROCESSING_MODE=sftp to enable) ---
# Remote: SFTP_ROOT/{issuer}/{year}/{month}/** (recursive, unlimited depth)
# Valid:  from_{issuer}_GA_834_INDV_*.xml | *.xml.gz | *.xml.xz
# Local:  source_data/{issuer}/{year}/{month}/*.xml  (flattened, no subfolders)
SFTP_HOST=sftp.example.com
SFTP_PORT=22
SFTP_USERNAME=dummy_user
SFTP_PASSWORD=dummy_password
SFTP_REMOTE_PATH=/archive/in/good/834

# SFTP audit-only mode (scan without downloading; uses same filters as above)
SFTP_AUDIT_ONLY=false

# Re-download even when local .xml exists (default: skip existing)
FORCE_DOWNLOAD=false

# Keep .xml.gz / .xml.xz copies alongside decompressed .xml
KEEP_COMPRESSED=false

# Relationship validity thresholds (record-level comparison)
RELATIONSHIP_MIN_RECORD_MATCH_RATE=70
RELATIONSHIP_MIN_STATUS_MATCH_RATE=85

# Never enable in production — local test fixtures only
USE_SYNTHETIC_DATA=false

# Optional heavy full raw+cleaned Excel exports (off by default)
ENABLE_FULL_DATA_EXPORT=false

# Prior-year benefit effective filter (off by default — does not change unfiltered pipeline)
FILTER_PRIOR_YEAR_BENEFIT_EFFECTIVE=false
# Reporting year Y for filter rule (optional; CLI --year also sets this)
REPORTING_YEAR=

# --- Fast business reporting (lightweight — does not replace full pipeline) ---
FAST_BUSINESS_REPORT_MODE=false
GENERATE_LEGACY_ASSETS_REPORTS=true
GENERATE_HTML_REPORTS=true
GENERATE_XLSX_REPORTS=true
GENERATE_SQLITE_REPORTS=true
GENERATE_DEBUG_DIAGNOSTICS=true
GENERATE_FULL_DATA_EXPORTS=false
GENERATE_BUSINESS_REVIEW_PACKAGE=false
GENERATE_FILTERED_REPORTS=false
GENERATE_PLOTLY_DASHBOARDS=false
GENERATE_STORAGE_ESTIMATE=false

# --- Azure SQL (read-only, ActiveDirectoryInteractive) ---
# Used by: run_azure_reconciliation.py, run_azure_mirror.py
SERVER=
DATABASE=
USERNAME=
DRIVER=ODBC Driver 17 for SQL Server
# Seconds to wait for interactive AAD sign-in (default 300 = 5 min)
CONNECTION_TIMEOUT=300
AZURE_ENROLLMENTS_TABLE=Enrollments_PY2026
AZURE_SQL_SCHEMA=dbo
# Legacy AZURE_SQL_* aliases also supported for SERVER/DATABASE/USERNAME/DRIVER
# PASSWORD is not used — authentication is ActiveDirectoryInteractive
